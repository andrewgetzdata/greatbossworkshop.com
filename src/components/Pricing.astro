---
import workshop from "../data/workshop.json";
import SectionHeading from "./SectionHeading.astro";

const inclusions = [
  "Full-day workshop (7 hours)",
  "Great Boss Toolkit",
  "Lunch and all materials",
  "Quarterly Conversations\u2122 framework",
  "Post-workshop resources",
  "Certificate of completion",
];
---

<section id="pricing" class="bg-eos-dark py-16 text-white md:py-24">
  <div class="mx-auto max-w-4xl px-4">
    <div class="flex flex-col items-center">
      <SectionHeading tone="light">Invest in Your Leadership</SectionHeading>
      <p class="mx-auto mt-3 max-w-xl text-center text-lg text-gray-400">
        Choose your workshop date and preferred payment method.
      </p>
    </div>

    <!-- What's Included -->
    <div class="mx-auto mt-10 max-w-2xl rounded-2xl bg-white p-8 text-gray-900 shadow-xl">
      <h3 class="text-center text-2xl font-bold text-eos-dark">What's Included</h3>
      <ul class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {inclusions.map((item) => (
          <li class="flex items-start gap-2">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-eos-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-gray-700">{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Date Selector (populated by JS) -->
    <div class="mt-12">
      <h3 class="mb-4 text-center text-sm font-semibold uppercase tracking-wide text-gray-400">
        Select a Workshop Date
      </h3>
      <div id="session-list" class="mx-auto grid max-w-2xl grid-cols-1 gap-3 sm:grid-cols-3">
        <p id="sessions-loading" class="col-span-full text-center text-sm text-gray-500">Loading available dates...</p>
      </div>
    </div>

    <p id="select-date-hint" class="mt-6 text-center text-sm text-eos-orange">
      Select a workshop date and payment method to continue &darr;
    </p>

    <!-- Payment Method -->
    <div class="mt-6">
      <h3 class="mb-4 text-center text-sm font-semibold uppercase tracking-wide text-gray-400">
        Choose Payment Method
      </h3>
      <div class="mx-auto grid max-w-2xl grid-cols-1 gap-4 sm:grid-cols-2">
        <button
          data-checkout="ach"
          disabled
          class="group relative w-full overflow-hidden rounded-xl border-2 border-eos-orange bg-eos-orange px-8 py-7 text-center text-white shadow-lg transition hover:bg-eos-orange-light hover:shadow-xl disabled:cursor-not-allowed disabled:opacity-50"
        >
          <span class="absolute right-0 top-0 rounded-bl-lg bg-white/20 px-3 py-1 text-[10px] font-bold uppercase tracking-wide">Recommended</span>
          <span class="mt-2 block text-sm font-bold uppercase tracking-wide">Bank Transfer (ACH)</span>
          <span id="price-ach" class="mt-2 block text-4xl font-extrabold">--</span>
          <span class="mt-2 block text-sm font-semibold opacity-90">No processing fee</span>
        </button>

        <button
          data-checkout="card"
          disabled
          class="w-full rounded-xl border-2 border-white/30 bg-white/5 px-8 py-7 text-center text-white shadow-lg transition hover:border-white/60 hover:bg-white/10 hover:shadow-xl disabled:cursor-not-allowed disabled:opacity-50"
        >
          <span class="block text-sm font-bold uppercase tracking-wide">Credit / Debit Card</span>
          <span id="price-card" class="mt-2 block text-4xl font-extrabold">--</span>
          <span class="mt-2 block text-sm font-semibold opacity-70">Includes 3% processing fee</span>
        </button>
      </div>

      <p class="mx-auto mt-4 max-w-2xl text-center text-xs text-gray-400">
        <svg class="mr-1 inline-block h-3.5 w-3.5 align-[-2px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        ACH payments are processed securely through Stripe and Plaid — the same bank-verification technology used by major financial institutions. Your credentials are never shared with us or stored on this site.
      </p>
    </div>

    <p class="mt-4 text-center text-sm text-gray-500">
      Secure payment powered by Stripe. Full refund available 14+ days before the workshop.
    </p>
  </div>

  <!-- Registration modal: collects EOS attendee fields before Stripe checkout -->
  <div id="reg-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4" role="dialog" aria-modal="true" aria-labelledby="reg-title">
    <div class="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-2xl bg-white p-6 text-gray-900 shadow-2xl sm:p-8">
      <div class="mb-5 flex items-start justify-between">
        <div>
          <h3 id="reg-title" class="text-xl font-bold text-eos-dark">Attendee details</h3>
          <p class="mt-1 text-sm text-gray-500">A few details EOS needs to register you. Payment is next.</p>
        </div>
        <button type="button" id="reg-close" aria-label="Close" class="ml-4 text-2xl leading-none text-gray-400 hover:text-gray-600">&times;</button>
      </div>

      <form id="reg-form" class="space-y-4">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <label class="block text-sm font-medium text-gray-700">First name*
            <input name="firstName" required class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-base focus:border-eos-orange focus:outline-none" />
          </label>
          <label class="block text-sm font-medium text-gray-700">Last name*
            <input name="lastName" required class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-base focus:border-eos-orange focus:outline-none" />
          </label>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <label class="block text-sm font-medium text-gray-700">Company*
            <input name="company" required class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-base focus:border-eos-orange focus:outline-none" />
          </label>
          <label class="block text-sm font-medium text-gray-700">Job title*
            <input name="jobTitle" required class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-base focus:border-eos-orange focus:outline-none" />
          </label>
        </div>
        <label class="block text-sm font-medium text-gray-700">Please describe your role*
          <textarea name="roleDesc" required rows="2" maxlength="480" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-base focus:border-eos-orange focus:outline-none"></textarea>
        </label>

        <fieldset class="rounded-lg border border-gray-200 p-3">
          <legend class="px-1 text-sm font-medium text-gray-700">Are you working with an EOS Implementer?*</legend>
          <div class="mt-1 flex gap-6">
            <label class="flex items-center gap-2 text-sm text-gray-700">
              <input type="radio" name="hasImplementer" value="yes" class="accent-eos-orange" /> Yes
            </label>
            <label class="flex items-center gap-2 text-sm text-gray-700">
              <input type="radio" name="hasImplementer" value="no" class="accent-eos-orange" /> No
            </label>
          </div>
          <label id="reg-implementer-name" class="mt-3 hidden text-sm font-medium text-gray-700">Your Implementer's name
            <input name="implementerName" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-base focus:border-eos-orange focus:outline-none" />
          </label>
          <label id="reg-learn-more" class="mt-3 hidden items-center gap-2 text-sm text-gray-700">
            <input type="checkbox" name="wantsMoreInfo" value="yes" class="accent-eos-orange" /> I'd like to learn more about running my business on EOS
          </label>
        </fieldset>

        <p id="reg-error" class="hidden text-sm text-red-600"></p>
        <button type="submit" id="reg-submit" class="w-full rounded-xl bg-eos-orange px-6 py-3 text-center font-bold text-white transition hover:bg-eos-orange-light">
          Continue to payment &rarr;
        </button>
      </form>
    </div>
  </div>
</section>

<script is:inline>
  var selectedProductId = null;

  function formatPrice(cents) {
    return '$' + (cents / 100).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function spotsText(session) {
    if (session.remaining <= 5) return 'Only ' + session.remaining + ' of ' + session.maxSeats + ' spots left';
    return session.remaining + ' of ' + session.maxSeats + ' spots available';
  }

  function spotsColor(session) {
    return session.remaining <= 5 ? '#f97316' : '#6b7280';
  }

  function renderSessions(sessions) {
    var container = document.getElementById('session-list');
    var loading = document.getElementById('sessions-loading');
    if (loading) loading.remove();

    if (!sessions || sessions.length === 0) {
      container.innerHTML = '<p class="col-span-full text-center text-gray-400">No upcoming workshops scheduled. Check back soon!</p>';
      return;
    }

    // Update price displays only (don't overwrite button HTML)
    var firstAvailable = sessions.find(function(s) { return s.status === 'on_sale'; });
    if (firstAvailable) {
      if (firstAvailable.priceAchAmount) {
        var achEl = document.getElementById('price-ach');
        if (achEl) achEl.textContent = formatPrice(firstAvailable.priceAchAmount * 100);
      }
      if (firstAvailable.priceCardAmount) {
        var cardEl = document.getElementById('price-card');
        if (cardEl) cardEl.textContent = formatPrice(firstAvailable.priceCardAmount * 100);
      }
    }

    container.innerHTML = '';
    sessions.forEach(function(session) {
      if (session.status === 'on_sale') {
        var btn = document.createElement('button');
        btn.setAttribute('data-product', session.productId);
        btn.className = 'session-card w-full rounded-xl border-2 border-gray-600 bg-white/5 px-4 py-3 text-left transition hover:border-eos-orange hover:bg-white/10';
        btn.innerHTML = '<p class="text-lg font-bold text-white">' + session.dateDisplay + '</p>'
          + '<p class="mt-1 text-sm text-gray-400">' + (session.location || '') + '</p>'
          + '<p class="session-spots mt-1 text-xs" style="color:' + spotsColor(session) + ';">'
          + spotsText(session) + '</p>';

        btn.addEventListener('click', function() { selectSession(session.productId); });
        container.appendChild(btn);

        // Restore selection if this was the selected card
        if (session.productId === selectedProductId) {
          btn.style.borderColor = '#f97316';
          btn.style.backgroundColor = 'rgba(255,255,255,0.15)';
        }

      } else if (session.status === 'sold_out') {
        var div = document.createElement('div');
        div.className = 'w-full rounded-xl border-2 border-gray-700 bg-white/5 px-4 py-3 text-left opacity-50';
        div.innerHTML = '<p class="text-lg font-bold text-gray-400">' + session.dateDisplay + '</p>'
          + '<p class="mt-1 text-sm text-gray-500">' + (session.location || '') + '</p>'
          + '<p class="mt-1 text-xs text-red-400">Sold out</p>';
        container.appendChild(div);

        // If this was the selected session and it just sold out, disable checkout
        if (session.productId === selectedProductId) {
          selectedProductId = null;
          document.querySelectorAll('[data-checkout]').forEach(function(btn) { btn.disabled = true; });
          var hint = document.getElementById('select-date-hint');
          if (hint) { hint.style.display = 'block'; hint.textContent = 'This session just sold out. Please select another date.'; }
        }
      }
    });

    // Fill remaining grid slots with "Coming soon" placeholders
    var totalCards = container.children.length;
    var remainder = totalCards % 3;
    if (remainder !== 0) {
      var fillCount = 3 - remainder;
      for (var i = 0; i < fillCount; i++) {
        var placeholder = document.createElement('div');
        placeholder.className = 'w-full rounded-xl border-2 border-dashed border-gray-700 bg-white/5 px-4 py-3 text-left opacity-40';
        placeholder.innerHTML = '<p class="text-lg font-bold text-gray-500">TBD</p>'
          + '<p class="mt-1 text-sm text-gray-600">New date</p>'
          + '<p class="mt-1 text-xs text-eos-orange">Coming soon</p>';
        container.appendChild(placeholder);
      }
    }
  }

  function updateSpotsOnly(sessions) {
    if (!sessions) return;
    sessions.forEach(function(session) {
      var card = document.querySelector('[data-product="' + session.productId + '"]');
      if (!card) return;

      // If it just sold out, re-render everything
      if (session.status === 'sold_out') {
        renderSessions(sessions);
        return;
      }

      // Otherwise just update the spots text
      var spotsEl = card.querySelector('.session-spots');
      if (spotsEl) {
        spotsEl.textContent = spotsText(session);
        spotsEl.style.color = spotsColor(session);
      }
    });
  }

  // 1. Load cached data instantly
  // 2. Then fetch fresh data in background to update spots
  (async function() {
    try {
      // Fast load from cache
      var res = await fetch('/api/list-sessions');
      if (!res.ok) throw new Error('Failed');
      var data = await res.json();
      renderSessions(data.sessions);

      // Background refresh with fresh data
      fetch('/api/list-sessions?fresh=1')
        .then(function(r) { return r.json(); })
        .then(function(freshData) {
          if (freshData.sessions) updateSpotsOnly(freshData.sessions);
        })
        .catch(function() {});

    } catch (e) {
      // Backend unreachable (not an empty schedule — that's handled in renderSessions).
      // Auto-retry once after a short delay before asking the visitor to act.
      var loading = document.getElementById('sessions-loading');
      if (loading) loading.textContent = 'Still loading available dates…';
      setTimeout(function() {
        fetch('/api/list-sessions?fresh=1')
          .then(function(r) { if (!r.ok) throw new Error('Failed'); return r.json(); })
          .then(function(retryData) { renderSessions(retryData.sessions); })
          .catch(function() {
            var el = document.getElementById('sessions-loading');
            if (el) el.textContent = "We couldn't load workshop dates right now. Please try again in a few minutes.";
          });
      }, 3000);
    }
  })();

  function selectSession(productId) {
    selectedProductId = productId;

    // Update card styles
    document.querySelectorAll('[data-product]').forEach(function(c) {
      c.style.borderColor = '#4b5563';
      c.style.backgroundColor = 'rgba(255,255,255,0.05)';
    });
    var selected = document.querySelector('[data-product="' + productId + '"]');
    if (selected) {
      selected.style.borderColor = '#f97316';
      selected.style.backgroundColor = 'rgba(255,255,255,0.15)';
    }

    // Enable checkout buttons
    document.querySelectorAll('[data-checkout]').forEach(function(btn) {
      btn.disabled = false;
    });

    // Hide the hint
    var hint = document.getElementById('select-date-hint');
    if (hint) hint.style.display = 'none';
  }

  // Checkout button opens the registration modal (payment happens after the form).
  var pendingMethod = null;

  document.querySelectorAll('[data-checkout]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (!selectedProductId) {
        alert('Please select a workshop date first.');
        return;
      }
      pendingMethod = btn.getAttribute('data-checkout');
      openRegModal();
    });
  });

  var regModal = document.getElementById('reg-modal');
  var regForm = document.getElementById('reg-form');
  var regError = document.getElementById('reg-error');
  var regSubmit = document.getElementById('reg-submit');

  function openRegModal() {
    regModal.classList.remove('hidden');
    regModal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }
  function closeRegModal() {
    regModal.classList.add('hidden');
    regModal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.getElementById('reg-close').addEventListener('click', closeRegModal);
  regModal.addEventListener('click', function(e) {
    if (e.target === regModal) closeRegModal();
  });

  // Show the branch field matching the implementer yes/no answer.
  regForm.querySelectorAll('input[name="hasImplementer"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      var yes = regForm.querySelector('input[name="hasImplementer"]:checked').value === 'yes';
      document.getElementById('reg-implementer-name').classList.toggle('hidden', !yes);
      var learnMore = document.getElementById('reg-learn-more');
      learnMore.classList.toggle('hidden', yes);
      learnMore.classList.toggle('flex', !yes);
    });
  });

  regForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    regError.classList.add('hidden');

    var fd = new FormData(regForm);
    var implementerChoice = regForm.querySelector('input[name="hasImplementer"]:checked');
    if (!implementerChoice) {
      regError.textContent = 'Please tell us whether you work with an EOS Implementer.';
      regError.classList.remove('hidden');
      return;
    }

    var attendee = {
      firstName: fd.get('firstName'),
      lastName: fd.get('lastName'),
      company: fd.get('company'),
      jobTitle: fd.get('jobTitle'),
      roleDesc: fd.get('roleDesc'),
      hasImplementer: implementerChoice.value,
      implementerName: fd.get('implementerName') || '',
      wantsMoreInfo: fd.get('wantsMoreInfo') ? 'yes' : 'no',
    };

    var originalText = regSubmit.textContent;
    regSubmit.textContent = 'Redirecting...';
    regSubmit.disabled = true;

    if (window.posthog) {
      window.posthog.capture('checkout_started', {
        method: pendingMethod,
        product_id: selectedProductId,
      });
    }

    try {
      var res = await fetch('/api/create-checkout-session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          paymentMethod: pendingMethod,
          productId: selectedProductId,
          attendee: attendee,
        }),
      });
      var data = await res.json();

      if (res.status === 409) {
        regError.textContent = 'Sorry, this session just sold out. Please choose another date.';
        regError.classList.remove('hidden');
        regSubmit.textContent = originalText;
        regSubmit.disabled = false;
        return;
      }
      if (!res.ok) throw new Error(data.error || 'Failed');
      window.location.href = data.url;
    } catch (err) {
      regError.textContent = 'Something went wrong. Please try again or contact us for assistance.';
      regError.classList.remove('hidden');
      regSubmit.textContent = originalText;
      regSubmit.disabled = false;
    }
  });
</script>
